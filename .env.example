# Copy to .env (git-ignored) and fill in. Only the two WEBULL_APP_* values are required.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=

# prod | sandbox
WEBULL_ENV=prod
WEBULL_REGION=us
# tcp (MQTT over TLS, port 1883, SDK default) | websockets (wss://...:8883/mqtt)
WEBULL_TRANSPORT=tcp
WEBULL_DEPTH=10

# Optional recorder settings (defaults shown)
# RECORDER_DATA_DIR=backend/data/recorder
# RECORDER_SERIES=KXBTC15M,KXETH15M,KXSOL15M,KXBTCD,KXETHD,KXSOLD
# RECORDER_PRODUCTS=BTC-USD,ETH-USD,SOL-USD
# RECORDER_HOURLY_STRIKES=7
# RECORDER_MAX_SYMBOLS=60
# RECORDER_DISCOVERY_SECONDS=30
# How often health records are saved (and the stall check runs)
# RECORDER_HEALTH_SECONDS=30
# How often a status line is printed to the terminal / journal; 0 = never
# RECORDER_LOG_SECONDS=900
# RECORDER_ZSTD_LEVEL=9
# Reconnect Webull if it sends nothing for this long (outside maintenance); 0 disables
# RECORDER_STALL_SECONDS=600
# Minutes added before and after Kalshi maintenance (Thursday 3-5 AM ET) and announced windows
# RECORDER_MAINTENANCE_BUFFER_MINUTES=15

# Kaggle upload (python -m backend.recorder.upload). Token: kaggle.com > Settings > API.
KAGGLE_API_TOKEN=
# <your-kaggle-username>/<dataset-slug>
KAGGLE_DATASET=
# KAGGLE_TITLE=Tradematic crypto event-contract ticks
